{"_id":"69a7864d984139a22c52d259","referenceId":"ad2befe7-093e-4d07-b554-83d7bdc3c720","type":"aiAgentJobTool","extension":"@cognigy/basic-nodes","label":"Tool","comment":"","commentColor":"","analyticsLabel":null,"isEntryPoint":false,"isDisabled":false,"mock":{"isEnabled":false,"code":""},"localizedData":[{"config":{"toolId":"bpp_fulfillment_or_enroll","description":"Handles Balance Protection Plan next-step action: either (a) send product summary/certificate link by sms, or (b) enroll if the caller explicitly consents; returns status and confirmation identifier. ","useParameters":true,"parameters":"{\n  \"type\": \"object\",\n  \"properties\": {\n    \"action\": {\n      \"type\": \"string\",\n      \"description\": \"What you want the tool to do. Allowed values: 'offer' (record permission + qualify only, no sending), 'send_materials' (send BPP docs via sms/email), 'enroll' (record enrollment choice if your backend supports enrollment).\"\n    },\n    \"verification_token\": {\n      \"type\": \"string\",\n      \"description\": \"Opaque token proving the caller is verified. Required for all actions in this demo.\"\n    },\n    \"permission_to_discuss\": {\n      \"type\": \"string\",\n      \"description\": \"Permission outcome for discussing the optional Balance Protection Plan. Allowed values: 'yes' | 'no' | 'not_asked' | 'unknown'. Use with action='offer'.\"\n    },\n    \"pay_behavior\": {\n      \"type\": \"string\",\n      \"description\": \"Light qualifying answer used to tailor the explanation (not personal advice). Allowed values: 'pays_in_full' | 'carries_balance' | 'sometimes' | 'unknown'. Use with action='offer'.\"\n    },\n    \"channel\": {\n      \"type\": \"string\",\n      \"description\": \"Delivery channel explicitly requested by the caller. Allowed values: 'email' | 'sms'. Required when action='send_materials'.\"\n    },\n    \"destination\": {\n      \"type\": \"string\",\n      \"description\": \"Optional destination (email address or mobile