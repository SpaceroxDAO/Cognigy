{"_id":"69a7864d984139a22c52d278","referenceId":"c410a94f-0797-4351-a424-6ebb83ce245d","type":"setHTMLAppState","extension":"@cognigy/basic-nodes","label":"xApp: Show HTML","comment":"","commentColor":"","analyticsLabel":null,"isEntryPoint":false,"isDisabled":false,"mock":{"isEnabled":false,"code":""},"localizedData":[{"config":{"mode":"body","html":"<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n\t<!-- \n\t\t\tloads the xApp Page SDK, provided by Cognigy,\n\t\t\texposed as a global variable called \"SDK\".\n\t-->\n\t<script src=\"/sdk/app-page-sdk.js\"></script>\n\t<script data-form-example>\n\twindow.addEventListener(\"load\", () => {\n\t\tconst form = document.querySelector('form');\n\t\tform.onsubmit = e => {\n\t\t\te.preventDefault();\n\t\t\te.stopPropagation();\n\t\t\tconst formData = new FormData(form);\n\t\t\tconst values = [...formData.entries()].reduce((obj, [key, value]) => {\n\t\t\t\tobj[key] = value;\n\t\t\t\treturn obj;\n\t\t\t}, {});\n\n\t\t\tSDK.submit(values);\n\t\t};\n\t});\n</script>\n\n</head>\n\n<body>\n\t\n\t<!-- \n\tExample: Form Submission \n\t\n\tThis example shows how you can use native HTML\n\tform functionality to submit data from your xApp.\n\n\tWe're rendering a simple form with a text input\n\tand a submit button.\n\n\tThe \"name\" attribute is important and will be used\n\tto identify this field in the result!\n\n\tUsing this example, the end user can type a nickname\n\tand submit it either via the button or by hitting \"return\".\n\n\tThe script will pick the first \"form\" element on the page\n\tand configures it to submit its result via the \"xApp Page SDK\"\n-->\n\t<form>\n\t<input \n\t\tname=\"nickname\" \n\t\tplaceholder=\"your nickname\"\n\t/> \n\t<button>submit</button>\n</form>\n\n\t\n<!-- \n\tExample: Submitting fixed values \n\n\tThis example shows how to submit fixed values by clicking a button.\n\tClicking the \"OK\" button will submit { option: \"ok\" },\n\twhile clicking the \"Cancel\" button will submit { option: \"cancel\" }\n-->\n<!--\n\t<button type=\"button\" onclick=\"SDK.submit({ option: 'ok' })\">OK</button>\n\t<button type=\"button\" onclick=\"SDK.submit({ option: 'cancel' })\">Cancel</button> \n-->\n\n\n</body>\n\n</html>\n","body":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <title>Balance Protection Plan</title>\n\n  <!-- Mobile safe-area + prevents notch/header overlap -->\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\" />\n\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n\n  <style>\n    :root{\n      /* Walmart True Blue + Spark Yellow */\n      --wm-blue: #0071CE;\n      --wm-yellow: #FFC220;\n      --wm-navy: #041F41;\n      --bg: #f6f8fb;\n    }\n\n    html, body {\n      margin: 0;\n      padding: 0;\n      font-family: 'Inter', system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;\n      background: var(--bg);\n      overflow-x: hidden;\n    }\n\n    /* Make sure content is never hidden under phone notches / OS bars */\n    body{\n      min-height: 100vh;\n      min-height: 100dvh;\n      padding-top: calc(env(safe-area-inset-top) + 12px);\n      padding-bottom: calc(env(safe-area-inset-bottom) + 12px);\n    }\n\n    /* Smooth, readable animations */\n    .fade-in-field {\n      opacity: 0;\n      transform: translateY(6px);\n      animation: fadeIn 0.35s ease-out forwards;\n    }\n    @keyframes fadeIn { to { opacity: 1; transform: translateY(0); } }\n\n    @keyframes shimmer {\n      0% { background-position: -200% 0; }\n      100% { background-position: 200% 0; }\n    }\n    .shimmer {\n      background: linear-gradient(\n        90deg,\n        rgba(0,113,206,0.08),\n        rgba(0,113,206,0.18),\n        rgba(0,113,206,0.08)\n      );\n      background-size: 200% 100%;\n      animation: shimmer 1.2s linear infinite;\n    }\n\n    /* Brand the slider */\n    input[type=\"range\"]{ accent-color: var(--wm-blue); }\n\n    /* Make taps feel better on mobile */\n    button, a { -webkit-tap-highlight-color: transparent; }\n  </style>\n</head>\n\n<body class=\"flex justify-center items-start px-3 sm:px-6\">\n  <div class=\"w-full max-w-md sm:max-w-xl lg:max-w-3xl mx-auto\">\n\n    <div class=\"bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden\">\n      <!-- Branded Hero Header -->\n      <header class=\"relative overflow-hidden\">\n        <div class=\"bg-[var(--wm-blue)] text-white px-4 sm:px-6 py-4 sm:py-5\">\n          <div class=\"absolute -right-12 -top-14 w-44 h-44 rounded-full bg-[var(--wm-yellow)]/25 blur-2xl\"></div>\n          <div class=\"absolute -left-14 -bottom-16 w-56 h-56 rounded-full bg-white/10 blur-2xl\"></div>\n\n          <div class=\"relative flex items-center justify-between gap-3\">\n            <div class=\"flex items-center gap-3 min-w-0\">\n              <!-- Walmart logo (provided URL) -->\n              <div class=\"bg-white rounded-xl p-1.5 shadow-sm shrink-0\">\n                <img\n                  src=\"https://yt3.googleusercontent.com/9UQaoHMqZ7LEnjCirXUVpgOq7n7pOTJv5YwKnN1tI-ekgiMKybVh4dYemcywJmiZlbX8fkiW2Q=s900-c-k-c0x00ffffff-no-rj\"\n                  alt=\"Walmart Rewards\"\n                  class=\"h-9 w-9 object-contain\"\n                />\n              </div>\n\n              <div class=\"min-w-0\">\n                <p class=\"text-xs text-white/90 truncate\">\n                  Walmart Rewards Card <span class=\"text-white/70\">• powered by</span> Fairstone Bank\n                </p>\n                <h1 class=\"text-lg sm:text-xl font-extrabold leading-tight\">\n                  Balance Protection Plan\n                </h1>\n              </div>\n            </div>\n\n            <!-- Fairstone logo (provided URL) -->\n            <div class=\"bg-white/95 rounded-xl p-2 shadow-sm shrink-0\">\n              <img\n                src=\"https://mma.prnewswire.com/media/1842621/Fairstone_Financial_Inc__Duo_Bank_of_Canada_Rebrands_to_Fairston.jpg?p=facebook\"\n                alt=\"Fairstone Bank\"\n                class=\"h-7 sm:h-8 object-contain\"\n              />\n            </div>\n          </div>\n\n          <div class=\"relative mt-3 flex items-center justify-between gap-3\">\n            <p class=\"text-sm text-white/90\">\n              Optional balance protection insurance for eligible cardholders.\n            </p>\n            <span class=\"inline-flex items-center rounded-full bg-[var(--wm-yellow)] text-[var(--wm-navy)]\n                         px-3 py-1 text-xs font-extrabold shadow-sm\">\n              Optional\n            </span>\n          </div>\n        </div>\n      </header>\n\n      <!-- Content -->\n      <div class=\"p-4 sm:p-6 space-y-4 sm:space-y-5\">\n\n        <!-- Token / Session (opaque) -->\n        <div id=\"tokenCard\" class=\"hidden rounded-xl border border-gray-200 bg-gray-50 p-3\">\n          <p class=\"text-gray-500 text-[11px] uppercase tracking-wide\">Session</p>\n          <p id=\"sessionToken\" class=\"text-gray-800 text-xs break-all\">–</p>\n        </div>\n\n        <!-- Key points -->\n        <section class=\"rounded-2xl border border-gray-200 p-4 space-y-3\">\n          <div class=\"flex items-center gap-2\">\n            <div class=\"w-2.5 h-2.5 rounded-full bg-[var(--wm-yellow)]\"></div>\n            <p class=\"text-gray-900 font-semibold\">What it can do (high level)</p>\n          </div>\n\n          <div class=\"space-y-2 text-sm text-gray-700\">\n            <p class=\"fade-in-field\" style=\"animation-delay: 60ms;\">\n              Depending on the covered event, it may make monthly payments toward your card balance.\n            </p>\n            <p class=\"fade-in-field\" style=\"animation-delay: 120ms;\">\n              For certain covered events, it may pay the balance up to a limit (see the certificate for details).\n            </p>\n            <p class=\"fade-in-field\" style=\"animation-delay: 180ms;\">\n              Premium is based on your statement balance (example shown below).\n            </p>\n          </div>\n\n          <div class=\"rounded-xl bg-[var(--wm-blue)]/10 border border-[var(--wm-blue)]/20 p-3\">\n            <p class=\"text-xs text-[var(--wm-navy)] font-bold\">Important</p>\n            <p class=\"text-sm text-[var(--wm-navy)] mt-1\">\n              This is not personal advice. Review the official certificate for eligibility, exclusions, and limits.\n            </p>\n          </div>\n        </section>\n\n        <!-- Premium example -->\n        <section class=\"rounded-2xl border border-gray-200 p-4 space-y-3\">\n          <div class=\"flex items-center justify-between\">\n            <p class=\"text-gray-900 font-semibold\">Premium example</p>\n            <span class=\"text-xs text-gray-500\">Illustrative</span>\n          </div>\n\n          <div class=\"rounded-xl bg-gray-50 border border-gray-200 p-3\">\n            <div class=\"flex items-center justify-between\">\n              <p class=\"text-gray-700 text-sm\">Statement balance</p>\n              <p id=\"balanceLabel\" class=\"text-gray-900 font-semibold\">$500</p>\n            </div>\n\n            <input\n              id=\"balanceSlider\"\n              type=\"range\"\n              min=\"0\"\n              max=\"2000\"\n              step=\"50\"\n              value=\"500\"\n              class=\"w-full mt-3\"\n            />\n\n            <div class=\"mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2\">\n              <div class=\"rounded-lg bg-white border border-gray-200 p-3\">\n                <p class=\"text-gray-500 text-[10px] uppercase tracking-wide\">Rate</p>\n                <p class=\"text-gray-900 text-sm font-semibold\">$1.09 per $100 + tax</p>\n              </div>\n              <div class=\"rounded-lg bg-white border border-gray-200 p-3\">\n                <p class=\"text-gray-500 text-[10px] uppercase tracking-wide\">Estimated premium</p>\n                <p id=\"premiumLabel\" class=\"text-gray-900 text-sm font-semibold\">$5.45 + tax</p>\n              </div>\n            </div>\n\n            <p class=\"text-xs text-gray-600 mt-2\">\n              If your statement balance is under $10, there may be no premium that month (see certificate).\n            </p>\n          </div>\n        </section>\n\n        <!-- Official docs -->\n        <section class=\"rounded-2xl border border-gray-200 p-4 space-y-2\">\n          <p class=\"text-gray-900 font-semibold\">Official documents</p>\n          <p class=\"text-sm text-gray-700\">\n            Use the links below to review full terms, exclusions, and cancellation details.\n          </p>\n\n          <div class=\"flex flex-col sm:flex-row gap-3\">\n            <a\n              id=\"certificateLink\"\n              href=\"#\"\n              target=\"_blank\"\n              class=\"flex-1 px-4 py-3 rounded-xl border border-gray-200 bg-white hover:bg-gray-50\n                     text-gray-900 font-semibold text-sm shadow-sm transition focus:outline-none\n                     focus-visible:ring-2 focus-visible:ring-[var(--wm-blue)]\"\n            >\n              📄 Open Certificate\n            </a>\n            <a\n              id=\"summaryLink\"\n              href=\"#\"\n              target=\"_blank\"\n              class=\"flex-1 px-4 py-3 rounded-xl border border-gray-200 bg-white hover:bg-gray-50\n                     text-gray-900 font-semibold text-sm shadow-sm transition focus:outline-none\n                     focus-visible:ring-2 focus-visible:ring-[var(--wm-blue)]\"\n            >\n              📄 Open Product Summary\n            </a>\n          </div>\n\n          <div class=\"rounded-xl bg-gray-50 border border-gray-200 p-3\">\n            <p class=\"text-xs text-gray-600\">\n              Cancellation: You may cancel within 30 days from the date coverage begins and receive a full refund of any premium paid (see certificate).\n            </p>\n          </div>\n        </section>\n\n        <!-- Actions -->\n        <section class=\"rounded-2xl border border-gray-200 p-4 space-y-3\">\n          <p class=\"text-gray-900 font-semibold\">Next step</p>\n          <p class=\"text-sm text-gray-700\">\n            Would you like to enroll over the phone now, or review these details first?\n          </p>\n\n          <div class=\"flex flex-col sm:flex-row gap-3\">\n            <button\n              id=\"enrollBtn\"\n              class=\"flex-1 px-4 py-3 rounded-xl bg-[var(--wm-blue)] hover:brightness-95\n                     text-white font-semibold text-sm shadow transition focus:outline-none\n                     focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[var(--wm-blue)]\"\n            >\n              ✅ Enroll over the phone\n            </button>\n\n            <button\n              id=\"reviewBtn\"\n              class=\"flex-1 px-4 py-3 rounded-xl bg-white hover:bg-gray-50\n                     border border-[var(--wm-blue)]/25 text-[var(--wm-blue)]\n                     font-semibold text-sm shadow-sm transition focus:outline-none\n                     focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[var(--wm-blue)]\"\n            >\n              🔎 I’ll review the link first\n            </button>\n          </div>\n\n          <button\n            id=\"declineBtn\"\n            class=\"w-full px-4 py-3 rounded-xl border border-gray-200 bg-white hover:bg-gray-50\n                   text-gray-800 font-semibold text-sm shadow-sm transition focus:outline-none\n                   focus-visible:ring-2 focus-visible:ring-[var(--wm-blue)]\"\n          >\n            No thanks\n          </button>\n\n          <div id=\"statusBar\" class=\"hidden rounded-xl border border-gray-200 bg-gray-50 p-3\">\n            <div class=\"h-3 w-full rounded-lg shimmer\"></div>\n            <p id=\"statusText\" class=\"text-xs text-gray-700 mt-2\">Submitting your choice…</p>\n          </div>\n        </section>\n\n      </div>\n    </div>\n\n    <!-- extra bottom breathing room on very small screens / embedded webviews -->\n    <div class=\"h-4\"></div>\n  </div>\n\n  <script>\n    // Read opaque token from query param (e.g., ?t=abc123)\n    const params = new URLSearchParams(window.location.search);\n    const token = params.get(\"t\") || \"\";\n\n    const tokenCard = document.getElementById(\"tokenCard\");\n    const sessionToken = document.getElementById(\"sessionToken\");\n\n    if (token) {\n      tokenCard.classList.remove(\"hidden\");\n      sessionToken.textContent = token;\n    }\n\n    // Replace these with your real hosted PDFs/URLs (or keep them behind a token-gated endpoint)\n    const certificateUrl = \"https://example.com/bpp/certificate\"; // <-- replace\n    const summaryUrl = \"https://example.com/bpp/summary\";         // <-- replace\n\n    document.getElementById(\"certificateLink\").href = certificateUrl;\n    document.getElementById(\"summaryLink\").href = summaryUrl;\n\n    // Premium example calculator: $1.09 per $100 of statement balance\n    const slider = document.getElementById(\"balanceSlider\");\n    const balanceLabel = document.getElementById(\"balanceLabel\");\n    const premiumLabel = document.getElementById(\"premiumLabel\");\n\n    function formatMoney(x) {\n      return x.toLocaleString(undefined, { style: \"currency\", currency: \"CAD\" });\n    }\n\n    function updatePremium() {\n      const bal = Number(slider.value || 0);\n      balanceLabel.textContent = formatMoney(bal);\n      const premium = (bal / 100) * 1.09;\n      premiumLabel.textContent = `${formatMoney(premium)} + tax`;\n    }\n    slider.addEventListener(\"input\", updatePremium);\n    updatePremium();\n\n    const statusBar = document.getElementById(\"statusBar\");\n    const statusText = document.getElementById(\"statusText\");\n\n    function submitChoice(choice) {\n      statusBar.classList.remove(\"hidden\");\n      statusText.textContent = \"Submitting your choice…\";\n\n      const payload = {\n        bpp_choice: choice, // \"enroll_over_phone\" | \"review_first\" | \"declined\"\n        xapp_context_token: token || \"\"\n      };\n\n      if (window.SDK && typeof window.SDK.submit === \"function\") {\n        SDK.submit(payload)\n          .then(() => SDK.close())\n          .catch(() => {\n            statusText.textContent = \"We couldn’t submit right now. You can close this page and tell the agent your choice.\";\n          });\n      } else {\n        console.log(\"Simulated Submit:\", payload);\n        statusText.textContent = \"Submitted (simulation). You can close this tab.\";\n      }\n    }\n\n    document.getElementById(\"enrollBtn\").addEventListener(\"click\", () => submitChoice(\"enroll_over_phone\"));\n    document.getElementById(\"reviewBtn\").addEventListener(\"click\", () => submitChoice(\"review_first\"));\n    document.getElementById(\"declineBtn\").addEventListener(\"click\", () => submitChoice(\"declined\"));\n  </script>\n</body>\n</html>","waitForInput":false,"storeResultInContext":"","contextKey":"result","screenTitle":"","showCloseIcon":true,"sendEventOnCloseIconClick":false,"autoOpen":true,"closeOnSubmit":true,"feedbackMessage":""},"preview":"","localeReference":"69a7864d984139a22c52d243"}],"chartReference":"69a7864d984139a22c52d247","resourceReference":"69a7864d984139a22c52d246","projectReference":"69a7864d984139a22c52d1e5","organisationReference":"676ec10638a57683744d287c"}