# Copy this file to .env and fill in your values.
# Never commit .env to git.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Used only by register-demo.js (server-side script, never exposed to browser)
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Used by import-package.js to upload ZIPs via Cognigy Management API
# Base URL: check your environment (trial = https://api-trial.cognigy.ai)
COGNIGY_BASE_URL=https://api-trial.cognigy.ai
# API key: Cognigy.AI > click avatar > My Profile > API Keys > Create
COGNIGY_API_KEY=your-api-key-here
# Project/agent ID: 24-char hex from the URL in Cognigy.AI (.../projects/{ID}/...)
COGNIGY_AGENT_ID=your-24-char-agent-id
