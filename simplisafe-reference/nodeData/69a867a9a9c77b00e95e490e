{"_id":"69a867a9a9c77b00e95e490e","referenceId":"31b50163-ac51-440a-a3a3-6c3cf693c258","type":"setHTMLAppState","extension":"@cognigy/basic-nodes","label":"VPN Processing","comment":"","commentColor":"","analyticsLabel":null,"isEntryPoint":false,"isDisabled":false,"mock":{"isEnabled":false,"code":""},"localizedData":[{"config":{"mode":"body","html":"<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n\t<!-- \n\t\t\tloads the xApp Page SDK, provided by Cognigy,\n\t\t\texposed as a global variable called \"SDK\".\n\t-->\n\t<script src=\"/sdk/app-page-sdk.js\"></script>\n\t<script data-form-example>\n\twindow.addEventListener(\"load\", () => {\n\t\tconst form = document.querySelector('form');\n\t\tform.onsubmit = e => {\n\t\t\te.preventDefault();\n\t\t\te.stopPropagation();\n\t\t\tconst formData = new FormData(form);\n\t\t\tconst values = [...formData.entries()].reduce((obj, [key, value]) => {\n\t\t\t\tobj[key] = value;\n\t\t\t\treturn obj;\n\t\t\t}, {});\n\n\t\t\tSDK.submit(values);\n\t\t};\n\t});\n</script>\n\n</head>\n\n<body>\n\t\n\t<!-- \n\tExample: Form Submission \n\t\n\tThis example shows how you can use native HTML\n\tform functionality to submit data from your xApp.\n\n\tWe're rendering a simple form with a text input\n\tand a submit button.\n\n\tThe \"name\" attribute is important and will be used\n\tto identify this field in the result!\n\n\tUsing this example, the end user can type a nickname\n\tand submit it either via the button or by hitting \"return\".\n\n\tThe script will pick the first \"form\" element on the page\n\tand configures it to submit its result via the \"xApp Page SDK\"\n-->\n\t<form>\n\t<input \n\t\tname=\"nickname\" \n\t\tplaceholder=\"your nickname\"\n\t/> \n\t<button>submit</button>\n</form>\n\n\t\n<!-- \n\tExample: Submitting fixed values \n\n\tThis example shows how to submit fixed values by clicking a button.\n\tClicking the \"OK\" button will submit { option: \"ok\" },\n\twhile clicking the \"Cancel\" button will submit { option: \"cancel\" }\n-->\n<!--\n\t<button type=\"button\" onclick=\"SDK.submit({ option: 'ok' })\">OK</button>\n\t<button type=\"button\" onclick=\"SDK.submit({ option: 'cancel' })\">Cancel</button> \n-->\n\n\n</body>\n\n</html>\n","body":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\" />\n  <title>SimpliSafe IT • Device Health Check (Cognigy XApp)</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n\n  <style>\n    :root{\n      --ss-blue: #082040;\n      --ss-yellow: #F09800;\n\n      --bg: #f6f8fb;\n      --card: #ffffff;\n      --muted: #64748b;\n      --border: rgba(2, 6, 23, 0.10);\n      --shadow: 0 18px 40px rgba(2, 6, 23, 0.10);\n    }\n\n    html, body {\n      background-color: var(--bg);\n      color: #0f172a;\n      padding: 0;\n      margin: 0;\n      height: 100%;\n      overflow: auto;              /* ✅ allow scrolling */\n      -webkit-overflow-scrolling: touch;\n    }\n\n    body::before{\n      content:\"\";\n      position: fixed;\n      inset: 0;\n      background:\n        radial-gradient(900px 500px at 20% 0%, rgba(8,32,64,0.18), transparent 60%),\n        radial-gradient(700px 500px at 100% 10%, rgba(240,152,0,0.20), transparent 55%),\n        radial-gradient(900px 600px at 60% 120%, rgba(8,32,64,0.10), transparent 60%);\n      pointer-events: none;\n    }\n\n    #container {\n      min-height: 100vh;           /* ✅ let content extend */\n      display: flex;\n      justify-content: center;\n      align-items: flex-start;     /* ✅ start at top (mobile) */\n      padding:\n        calc(env(safe-area-inset-top) + 14px)\n        calc(env(safe-area-inset-right) + 14px)\n        calc(env(safe-area-inset-bottom) + 14px)\n        calc(env(safe-area-inset-left) + 14px);\n      position: relative;\n    }\n\n    .phone {\n      width: 100%;\n      max-width: 430px;\n      display: flex;\n      flex-direction: column;\n      border-radius: 24px;\n      background: rgba(255,255,255,0.72);\n      border: 1px solid rgba(8,32,64,0.12);\n      box-shadow: var(--shadow);\n      backdrop-filter: blur(10px);\n      overflow: hidden;\n    }\n\n    .topbar {\n      background: linear-gradient(135deg, rgba(8,32,64,1), rgba(8,32,64,0.94));\n      color: white;\n      padding: 14px 16px;\n      border-bottom: 1px solid rgba(255,255,255,0.14);\n      position: sticky;           /* ✅ stays visible while scrolling */\n      top: 0;\n      z-index: 5;\n    }\n\n    .pill {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      padding: 6px 10px;\n      border-radius: 999px;\n      background: rgba(255,255,255,0.10);\n      border: 1px solid rgba(255,255,255,0.16);\n      font-size: 12px;\n      line-height: 1;\n      white-space: nowrap;\n    }\n\n    .dot {\n      width: 8px;\n      height: 8px;\n      border-radius: 999px;\n      background: var(--ss-yellow);\n      box-shadow: 0 0 0 3px rgba(240,152,0,0.22);\n    }\n\n    .content {\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n      padding: 14px;\n    }\n\n    .card {\n      background: var(--card);\n      border: 1px solid var(--border);\n      border-radius: 18px;\n      padding: 14px;\n    }\n\n    .metric {\n      border: 1px solid rgba(8,32,64,0.10);\n      border-radius: 14px;\n      padding: 10px 12px;\n      background: linear-gradient(180deg, rgba(248,250,252,0.9), rgba(248,250,252,0.6));\n    }\n\n    .badge {\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n      border-radius: 999px;\n      padding: 6px 10px;\n      font-size: 12px;\n      border: 1px solid rgba(8,32,64,0.14);\n      background: rgba(8,32,64,0.05);\n      color: rgba(8,32,64,1);\n      font-weight: 700;\n    }\n\n    .badge.warn {\n      border-color: rgba(240,152,0,0.40);\n      background: rgba(240,152,0,0.12);\n      color: #7a4b00;\n    }\n    .badge.ok {\n      border-color: rgba(8,32,64,0.20);\n      background: rgba(8,32,64,0.06);\n      color: rgba(8,32,64,1);\n    }\n\n    .btn {\n      width: 100%;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 10px;\n      border-radius: 14px;\n      padding: 12px 14px;\n      font-weight: 800;\n      border: 1px solid rgba(8,32,64,0.18);\n      background: rgba(255,255,255,0.90);\n      color: rgba(8,32,64,1);\n      transition: transform 120ms ease, background 120ms ease;\n      user-select: none;\n    }\n    .btn:active { transform: scale(0.99); }\n\n    .btn.primary {\n      border-color: rgba(240,152,0,0.55);\n      background: linear-gradient(180deg, rgba(240,152,0,1), rgba(240,152,0,0.92));\n      color: #082040;\n    }\n\n    /* Console */\n    #output {\n      width: 100%;\n      height: 52vh;               /* ✅ fixed height so it can scroll internally */\n      max-height: 520px;\n      background-color: #071a34;\n      border: 1px solid rgba(255,255,255,0.10);\n      border-radius: 16px;\n      padding: 1rem;\n      font-size: 0.875rem;\n      line-height: 1.6;\n      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.06);\n      white-space: pre-wrap;\n      overflow-y: auto;           /* ✅ console scroll */\n      -webkit-overflow-scrolling: touch;\n      color: rgba(255,255,255,0.92);\n      font-family: 'Courier New', monospace;\n    }\n\n    .cursor {\n      display: inline-block;\n      width: 10px;\n      background: var(--ss-yellow);\n      margin-left: 2px;\n      animation: blink 1s step-start 0s infinite;\n    }\n    @keyframes blink {\n      50% { background: transparent; }\n    }\n  </style>\n</head>\n\n<body>\n  <div id=\"container\">\n    <div class=\"phone\">\n\n      <div class=\"topbar\">\n        <div class=\"flex items-center justify-between gap-3\">\n          <div class=\"flex items-center gap-3 min-w-0\">\n            <img\n              src=\"https://cdn.cookielaw.org/logos/9824ffc2-7e09-40dd-9417-91127fc5c995/9c6dde6a-3379-43d5-b685-06c4565e1fe5/28014ef8-f9d4-48b4-8520-a46d0e0306e6/SimpliSafe-wordmark-RGB-BlueYellow.png\"\n              alt=\"SimpliSafe\"\n              class=\"h-6 w-auto bg-white/95 rounded-md px-2 py-1\"\n            />\n            <div class=\"min-w-0\">\n              <div class=\"text-sm font-semibold tracking-wide truncate\">Internal IT Support</div>\n              <div class=\"text-xs text-white/80 truncate\">Device Health Check</div>\n            </div>\n          </div>\n\n          <!-- ✅ Placeholder user -->\n          <div class=\"pill\">\n            <span class=\"dot\"></span>\n            <span>Session: adam.boyle@simplisafe.com</span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"content\">\n\n        <div class=\"card\">\n          <div class=\"flex items-start justify-between gap-3\">\n            <div>\n              <div class=\"text-base font-extrabold\" style=\"color: var(--ss-blue);\">Health Summary</div>\n              <div class=\"text-xs\" style=\"color: var(--muted);\">\n                Example placeholders (swap with Cognigy context later)\n              </div>\n            </div>\n\n            <!-- ✅ Placeholder overall status -->\n            <div class=\"badge warn\">\n              <span>Overall:</span>\n              <span>Needs Attention</span>\n            </div>\n          </div>\n\n          <div class=\"grid grid-cols-3 gap-2 mt-3\">\n            <div class=\"metric\">\n              <div class=\"text-[11px] font-semibold\" style=\"color: var(--muted);\">OS</div>\n              <div class=\"text-sm font-extrabold\" style=\"color: var(--ss-blue);\">iOS 23</div>\n              <div class=\"text-[11px]\" style=\"color: var(--muted);\">Build 23A104</div>\n            </div>\n\n            <div class=\"metric\">\n              <div class=\"text-[11px] font-semibold\" style=\"color: var(--muted);\">Disk</div>\n              <div class=\"text-sm font-extrabold\" style=\"color: var(--ss-blue);\">18% free</div>\n              <div class=\"text-[11px]\" style=\"color: var(--muted);\">11.2 GB</div>\n            </div>\n\n            <div class=\"metric\">\n              <div class=\"text-[11px] font-semibold\" style=\"color: var(--muted);\">Security</div>\n              <div class=\"text-sm font-extrabold\" style=\"color: var(--ss-blue);\">AV: Active</div>\n              <div class=\"text-[11px]\" style=\"color: var(--muted);\">FW: On</div>\n            </div>\n          </div>\n\n          <div class=\"grid grid-cols-2 gap-2 mt-3\">\n            <button class=\"btn primary\" type=\"button\" onclick=\"startHealthCheck()\">\n              <span>▶</span>\n              <span>Run Health Check</span>\n            </button>\n            <button class=\"btn\" type=\"button\" onclick=\"scrollToBottom()\">\n              <span>↓</span>\n              <span>Jump to Latest</span>\n            </button>\n          </div>\n        </div>\n\n        <div class=\"card\">\n          <div class=\"flex items-center justify-between pb-2\">\n            <div class=\"text-sm font-extrabold\" style=\"color: var(--ss-blue);\">Diagnostics Console</div>\n            <div class=\"text-xs\" style=\"color: var(--muted);\">\n              Device: SS-iPhone-0142 • iOS\n            </div>\n          </div>\n\n          <!-- ✅ Starts empty and does NOT auto-run -->\n          <div id=\"output\">Tap “Run Health Check” to begin…</div>\n        </div>\n\n        <div class=\"card\">\n          <div class=\"text-sm font-extrabold\" style=\"color: var(--ss-blue);\">Recommended Actions</div>\n          <ul class=\"mt-2 text-sm\" style=\"color: var(--muted);\">\n            <li>• Connect to a trusted Wi-Fi network and retry VPN profile sync.</li>\n            <li>• Free up at least 10 GB storage for policy updates.</li>\n            <li>• If the issue persists, contact IT for a re-enrollment push.</li>\n          </ul>\n        </div>\n\n      </div>\n    </div>\n  </div>\n\n  <script>\n    const output = document.getElementById(\"output\");\n\n    // --- ORIGINAL VPN DIAGNOSTIC LINES (kept) ---\n    const vpnLogs = [\n      \"🔄 Running VPN Diagnostic...\",\n      \"⧖ Connecting to Intune management interface...\",\n      \"✓ Policy Sync Initialized\",\n      \"⚠️ Configuration Error Detected\",\n      \"Status: ERROR\",\n      \"Code: VPN_PROFILE_MISMATCH_403\",\n      \"Details: Assigned VPN profile does not match device compliance baseline.\",\n      \"Detected at: 2026-03-02T10:18:22-05:00\",\n      \"\",\n      \"🔍 Issue Identified: VPN Profile Mismatch\",\n      \"✘ Assigned VPN configuration failed to apply\",\n      \"⧖ Starting remediation using Microsoft Graph...\",\n      \"\",\n      \"🔧 Remediation in progress...\",\n      \"Method: Re-push VPN Profile + Trigger Intune Sync\",\n      \"Status: IN_PROGRESS\",\n      \"Initiated at: 2026-03-02T10:19:10-05:00\",\n      \"Resolved: true\",\n      \"\",\n      \"✅ VPN Configuration Successfully Restored\"\n    ];\n\n    // Device Health prelude (placeholders)\n    const healthPrelude = [\n      \"🛡️ SimpliSafe IT • Device Health Check\",\n      \"Device: SS-iPhone-0142 (iOS 23 • Build 23A104)\",\n      \"User: adam.boyle@simplisafe.com\",\n      \"Time: 2026-03-02 10:17:54 ET\",\n      \"\",\n      \"✓ MDM Enrollment: Intune (Compliant)\",\n      \"✓ Encryption: Enabled\",\n      \"✓ Battery Health: 92%\",\n      \"⚠️ Storage: Low (18% free • 11.2 GB)\",\n      \"✓ Wi-Fi: Connected (SimpliSafe-Guest)\",\n      \"✓ Certificates: Valid\",\n      \"\",\n      \"— Starting network diagnostics —\",\n      \"\"\n    ];\n\n    let timerIds = [];\n    let lineIndex = 0;\n    let charIndex = 0;\n    let cursor = null;\n\n    function clearTimers() {\n      timerIds.forEach(id => clearTimeout(id));\n      timerIds = [];\n    }\n\n    function ensureCursor() {\n      if (cursor && cursor.isConnected) return;\n      cursor = document.createElement(\"span\");\n      cursor.classList.add(\"cursor\");\n      output.appendChild(cursor);\n    }\n\n    function scrollToBottom() {\n      output.scrollTop = output.scrollHeight;\n    }\n\n    function clearOutput() {\n      output.innerHTML = \"\";\n    }\n\n    function typeLines(lines) {\n      ensureCursor();\n\n      if (lineIndex >= lines.length) {\n        if (cursor && cursor.isConnected) cursor.remove();\n        return;\n      }\n\n      const line = lines[lineIndex];\n\n      if (charIndex < line.length) {\n        cursor.insertAdjacentText(\"beforebegin\", line.charAt(charIndex));\n        charIndex++;\n        scrollToBottom();\n        const id = setTimeout(() => typeLines(lines), 10);\n        timerIds.push(id);\n      } else {\n        cursor.insertAdjacentHTML(\"beforebegin\", \"\\n\");\n        lineIndex++;\n        charIndex = 0;\n        const id = setTimeout(() => typeLines(lines), 10);\n        timerIds.push(id);\n      }\n    }\n\n    function startHealthCheck() {\n      // ✅ Only runs when button clicked\n      clearTimers();\n      clearOutput();\n\n      lineIndex = 0;\n      charIndex = 0;\n      cursor = null;\n\n      const all = [...healthPrelude, ...vpnLogs];\n      typeLines(all);\n    }\n\n    // ✅ No window.onload auto-run anymore\n  </script>\n</body>\n</html>","waitForInput":false,"storeResultInContext":"","contextKey":"result","screenTitle":"","showCloseIcon":true,"sendEventOnCloseIconClick":false,"autoOpen":true,"closeOnSubmit":true,"feedbackMessage":""},"preview":"","localeReference":"69a867a9a9c77b00e95e48b0"}],"chartReference":"69a867a9a9c77b00e95e48b6","resourceReference":"69a867a9a9c77b00e95e48b5","projectReference":"69a867a9a9c77b00e95e484c","organisationReference":"676ec10638a57683744d287c"}