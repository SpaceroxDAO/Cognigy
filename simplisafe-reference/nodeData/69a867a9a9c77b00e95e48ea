{"_id":"69a867a9a9c77b00e95e48ea","referenceId":"616e971a-dc6f-4ee8-854b-d22b66b87ce9","type":"code","extension":"@cognigy/basic-nodes","label":"Clean API Device Health Data","comment":"","commentColor":"","analyticsLabel":null,"isEntryPoint":false,"isDisabled":false,"mock":{"isEnabled":false,"code":""},"localizedData":[{"config":{"code":"const response = input.deviceHealthCheckResponse || context.deviceHealthCheckResponse;\n\nconst flaggedDevices = [];\nlet flaggedDevicesText = \"\";\n\nif (response && Array.isArray(response.value)) {\n  for (const device of response.value) {\n    const issues = [];\n\n    if (device.complianceState !== \"compliant\") {\n      issues.push(\"non-compliant\");\n    }\n\n    if (device.vpnConfigurationStatus !== \"success\") {\n      issues.push(\"VPN configuration failed\");\n    }\n\n    if (issues.length > 0) {\n      const issueLine = `Device \"＄{device.deviceName}\" (${device.operatingSystem}), last checked on ${new Date(device.lastSyncDateTime).toLocaleString(\"en-US\", {\n        dateStyle: \"long\",\n        timeStyle: \"short\",\n        timeZone: \"America/Los_Angeles\"\n      })}, has the following issue(s): ${issues.join(\" and \")}.`;\n\n      flaggedDevicesText += issueLine + \"\\n\";\n\n      flaggedDevices.push({\n        id: device.id,\n        name: device.deviceName,\n        os: device.operatingSystem,\n        lastChecked: device.lastSyncDateTime,\n        issues: issues\n      });\n    }\n  }\n}\n\ncontext.flaggedDevices = flaggedDevices;\ncontext.flaggedDevicesText = flaggedDevicesText.trim();","hasError":true,"transpiled":""},"preview":"","localeReference":"69a867a9a9c77b00e95e48b0"}],"chartReference":"69a867a9a9c77b00e95e48b6","resourceReference":"69a867a9a9c77b00e95e48b5","projectReference":"69a867a9a9c77b00e95e484c","organisationReference":"676ec10638a57683744d287c"}